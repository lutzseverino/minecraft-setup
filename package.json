{
  "name": "minecraft-setup",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:node": "npm run lint && node --test scripts/release-version.test.mjs && npm --prefix protocol run check && npm --prefix manager run check",
    "check:protocol": "node scripts/check.mjs protocol",
    "check:manager": "node scripts/check.mjs manager",
    "check:publisher": "node scripts/check.mjs publisher",
    "test": "node --test scripts/release-version.test.mjs",
    "lint": "node protocol/node_modules/@biomejs/biome/bin/biome check ."
  }
}
